# Server-side API URL and shared secret (never use NEXT_PUBLIC_ for the secret)
DASHBOARD_API_URL=https://your-api-domain.example/api/v1
DASHBOARD_API_KEY=SET_THE_SAME_RANDOM_KEY_AS_THE_BOT_API

# NextAuth Configuration
NEXTAUTH_URL=https://your-deployment-domain.example/
NEXTAUTH_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Discord OAuth configuration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Admin User IDs (comma separated)
NEXT_PUBLIC_ADMIN_IDS=1353995912006860871

# Customizable Brand / Bot name shown across the dashboard
NEXT_PUBLIC_BRAND_NAME="DARK ON TOP"
NEXT_PUBLIC_SERVER_NAME="༺ 𝐃 Λ ⴽ 𝐊† 𓆩₴Ɲ𓆪 𝐓 Ø 𝐏 ༻"
NEXT_PUBLIC_BRAND_NAME_WORD="DOT"